<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.chaptercutter.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>


    <!-- Section for .docx file processing -->
    <Label fx:id="statusLabel" text="Select a .docx file to process."/>
    <Button text="Choose File" onAction="#handleChooseFile"/>
    <TextField fx:id="limiting" layoutX="50.0" layoutY="80.0" prefWidth="300.0" promptText="Enter limit number" />


</VBox>
